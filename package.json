{
  "name": "task-tracker",
  "version": "1.0.0",
  "description": "A command line task tracker built with TypeScript and clean architecture",
  "license": "MIT",
  "bin": {
    "task-cli": "dist/app.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "ts-node src/app.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "start": "node dist/app.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepare": "yarn build"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "jest": "^30.5.1",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
